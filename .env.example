# LoanLens runtime configuration (copy to .env and fill in as needed).
# Do not commit real secrets. Empty provider keys are valid for local skeleton runs.

# Deployment environment: local | test | production
APP_ENV=local

# Enable verbose / development behaviour (true/false)
DEBUG=false

# Worker lease duration before a claimed job may be reclaimed (seconds)
WORKER_LEASE_TTL_SECONDS=60

# Bounded retries for a processing run before recorded failure
MAX_PROCESSING_RETRIES=3

# Maximum accepted upload size in bytes (default 26214400 = 25 MiB)
MAX_UPLOAD_SIZE_BYTES=26214400

# PostgreSQL connection URL (placeholder credentials for local Compose only)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/loanlens

# Quarantine (pre-scan) and clean (post-scan) storage directories
QUARANTINE_DIR=./data/quarantine
CLEAN_UPLOADS_DIR=./data/clean_uploads

# ClamAV clamd host and port (Compose scanner service)
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
# Backend: mock (tests/local) | clamav (Compose). Fallback when clamd is down.
CLAMAV_BACKEND=mock
CLAMAV_FALLBACK_TO_MOCK=true

# Optional LLM provider API keys (leave empty until a provider is configured)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Session cookie and timeouts (configuration keys; not product security requirements)
SESSION_COOKIE_NAME=loanlens_session
SESSION_IDLE_TIMEOUT_SECONDS=1800
SESSION_ABSOLUTE_TIMEOUT_SECONDS=86400

# Argon2id cost parameters (configuration keys; security specification unset)
ARGON2_TIME_COST=2
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=1

# Comma-separated front-end origins for CORS (no wildcard with credentials)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
